MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/authdb
MONGODB_DB=offframe
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=OFFFRAME
ADMIN_PASSWORD=replace-with-your-admin-password
# Optional: explicitly configure absolute ISO timestamps with a timezone offset.
# Otherwise the administrator sets the schedule in the website.
SUBMISSION_OPENS_AT=
SUBMISSION_CLOSES_AT=
EVENT_TIMEZONE=Asia/Kolkata
# Public HTTPS origin, e.g. https://offframe.example.com (no trailing slash).
# Used by both the server (origin/CORS checks, secure cookies) and the browser
# (API base URL) so frontend and backend always agree on one address.
# Leave blank for local development (127.0.0.1/localhost is inferred).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
